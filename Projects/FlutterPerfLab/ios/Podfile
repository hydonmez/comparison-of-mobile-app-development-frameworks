# Enforces iOS 14.0 as the minimum baseline for compatibility 
# between Google Maps (Metal API) and CoreMotion hardware sensors.
platform :ios, '14.0'

# Build Optimization
# Disabling CocoaPods analytics prevents synchronous network latency 
# during the pre-compilation phase.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run 'flutter pub get' first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT resolution failed. Check Generated.xcconfig."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      
      # Align all pod dependencies to iOS 14.0.
      # Prevents issues where sub-dependencies target older SDKs, 
      # causing intermittent link-time failures.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      
      # Hardware Permission Macros
      # Instructs the pre-processor to compile the bridge code for hardware sensors. 
      # Without these definitions, the native code for CoreMotion/Pedometer remains unlinked.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_SENSORS=1',    # Enables Accelerometer/Gyroscope/Magnetometer
        'PERMISSION_MOTION=1'      # Enables Pedometer/Step Counter
      ]
    end
  end
end